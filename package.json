  "description": "Gitmoji commit rules: emoji only, emoji and type must agree, 50-character summary, one-sentence body.",
  "license": "MIT",
  "type": "module",
  "exports": "./index.js",
  "files": [
    "index.js",
    "rules.js",
    "gitmoji-types.js"
  ],
  "scripts": {
