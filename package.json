    "hooks": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remo-vonarx/commitlint-config.git"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@commitlint/cli": ">=21"
  },
  "dependencies": {
    "@gitmoji/commit-types": "1.1.5",
    "commitlint-config-gitmoji": "2.3.1",
    "commitlint-plugin-gitmoji": "2.2.6",
    "gitmojis": "3.15.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "husky": "9.1.7"
  }
